{
  "publish_as_vars": true,
  "publish_to_influxdb": true,
  "influxdb": {
    "measurement": "weatherhat",
    "station": "CGallsky"
  },
  "debug": true,
  "datalogging": true,
  "barometer": {
    "altitude_meters_asl": 38
  },
  "pressure_tendency": {
    "available_window_hours": [
      3,
      6,
      24
    ],
    "window_hours": 3,
    "steady_threshold_hpa": 0.2,
    "restore_max_age_minutes": 5
  },
  "rain_event": {
    "dry_period_minutes": 30
  },
  "temperature": {
    "available_adjustment_methods": [
      "polynomial",
      "linear"
    ],
    "adjustment_method": "linear",
    "linear": {
      "slope": 1.0,
      "intercept": -1.0
    },
    "polynomial": {
      "available_degrees": [
        2,
        3,
        4,
        5,
        6
      ],
      "degree": 3,
      "coef_0": 0.0,
      "coef_1": 1.0,
      "coef_2": 0.0,
      "coef_3": 0.0,
      "coef_4": 0.0,
      "coef_5": 0.0,
      "coef_6": 0.0
    }
  },
  "humidity": {
    "available_adjustment_methods": [
      "polynomial",
      "linear"
    ],
    "adjustment_method": "polynomial",
    "linear": {
      "slope": 1.0,
      "intercept": 0.0
    },
    "polynomial": {
        "available_degrees": [
          2,
          3,
          4,
          5,
          6
        ],
        "degree": 2,
        "coef_0": 0.0,
        "coef_1": 1.0,
        "coef_2": 0.0,
        "coef_3": 0.0,
        "coef_4": 0.0,
        "coef_5": 0.0,
        "coef_6": 0.0
    }
  },
  "sampling": {
    "cpu_temperature_interval_seconds": 5.0,
    "hat_measurements_interval_minutes": 1.0,
    "cpu_temperature_samples_to_average": 5
  }
}
